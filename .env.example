# 传播 X 光本地配置
# 本应用不需要付费 API、密钥或远程上传。
# 可选：启动本地 OpenAI 兼容模型服务后，在界面中启用。
XRAY_DATA_DIR=data/runtime
XRAY_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
XRAY_LOCAL_LLM_MODEL=qwen2.5:3b


# 齐鲁卖点真实模型配置（应用读取环境变量，不自动加载此文件）
STUDIO_MODEL_BASE_URL=http://127.0.0.1:11434/v1
STUDIO_MODEL_NAME=qwen2.5vl:3b
# 仅远程服务按需要配置，切勿把真实密钥提交到仓库。
# STUDIO_MODEL_API_KEY=
